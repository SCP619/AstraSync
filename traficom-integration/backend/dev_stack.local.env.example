# Copy to dev_stack.local.env (git-ignored) to override the local development stack's ports.
# Environment variables of the same name take precedence. Keep the UI in step:
# traficom-integration/ui/.env.development.local sets VITE_API_BASE_URL and VITE_OIDC_AUTHORITY.
ASTRASYNC_DEV_API_PORT=8800
ASTRASYNC_DEV_IDP_PORT=8801
ASTRASYNC_DEV_UI_PORT=5173
