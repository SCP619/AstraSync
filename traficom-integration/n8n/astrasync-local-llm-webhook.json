{
  "name": "AstraSync — Local LLM Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "astrasync-llm",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "name": "Webhook",
      "webhookId": "5ed36287-c4e0-4ec4-a038-f1a5e6e91fea",
      "credentials": { "httpHeaderAuth": { "name": "Header Auth account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.user }}\n",
        "messages": { "messageValues": [{ "message": "={{ $json.body.system }}\n" }] },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [224, 0],
      "name": "Basic LLM Chain"
    },
    {
      "parameters": { "model": "qwen3:8b", "options": { "think": false } },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [160, 208],
      "name": "Ollama Chat Model",
      "credentials": { "ollamaApi": { "name": "Ollama account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { text: $json.text } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [592, 0],
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Basic LLM Chain", "type": "main", "index": 0 }]] },
    "Ollama Chat Model": {
      "ai_languageModel": [[{ "node": "Basic LLM Chain", "type": "ai_languageModel", "index": 0 }]]
    },
    "Basic LLM Chain": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "executionTimeout": 180
  }
}
