# Local development stack only (backend/tests/support/dev_stack.py). Contains no secrets.
# Default ports. To use others on one machine, put overrides in .env.development.local
# (git-ignored) and the same ports in backend/dev_stack.local.env.
VITE_API_BASE_URL=http://127.0.0.1:8800
VITE_OIDC_AUTHORITY=http://127.0.0.1:8801
VITE_OIDC_CLIENT_ID=astrasync-dev-ui
VITE_OIDC_SCOPE=openid astrasync.api
