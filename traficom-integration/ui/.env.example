# Copy to .env.production for a packaged build. Contains no secrets: a client can't keep any.
VITE_API_BASE_URL=https://astrasync.example
VITE_OIDC_AUTHORITY=https://identity.example/realms/astrasync
VITE_OIDC_CLIENT_ID=astrasync-client
VITE_OIDC_SCOPE=openid astrasync.api
# Android only. Set to true only when a Firebase project and google-services.json are in place.
VITE_PUSH_CONFIGURED=false
