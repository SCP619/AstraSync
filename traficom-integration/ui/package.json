{
  "name": "astrasync-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:drift": "node scripts/generate-contract.mjs --check",
    "contract:typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "test": "vitest run",
    "contract:check": "npm run contract:drift && npm run contract:typecheck"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "oidc-client-ts": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  }
}
