    "@tauri-apps/plugin-opener": "^2.7.2",
    "@types/three": "0.170.0",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "3.5.0",
    "three": "0.170.0"
  }
